# =============================================================================
# contract.env - what scripts/build.sh needs to know about THIS contract
# (template from ci/components examples/contract.env, values of
# apps/drawboard/api). Shell syntax, read by scripts/build.sh.
# =============================================================================

# Stem of every published name: Maven artifact drawboard-api-kotlin, spec in
# the jar at META-INF/resources/openapi/drawboard-api.yaml
API_NAME=drawboard-api
# Maven group. dergeorg projects: at.dergeorg.<app>
API_GROUP=at.dergeorg.drawboard
# Kotlin package of the generated interfaces (.api), models (.model) and
# config (.config). Must stay under the app's root package so the backend's
# component scan finds the generated EnumConverterConfiguration.
API_BASE_PACKAGE=at.dergeorg.drawboard.contract
# true = WebFlux + coroutines (suspend funs); false = Spring MVC
API_REACTIVE=true
# npm package of the typescript-angular client. Scope = root group of this
# GitLab project, so it resolves through the instance-level npm endpoint.
API_NPM_NAME=@apps/drawboard-api
API_DESCRIPTION="Generated Kotlin Spring interfaces and models of the drawboard API"
# Repository link in the generated package.json / README
GIT_USER_ID=apps/drawboard
GIT_REPO_ID=api

# Keycloak issuer: openapi.yaml carries the placeholder, the bundle gets the
# issuer. No Keycloak (own login): KEYCLOAK_PLACEHOLDER= (empty).
KEYCLOAK_PLACEHOLDER=https://auth.dergeorg.at/realms/dergeorg
KEYCLOAK_ISSUER=https://auth.dergeorg.at/realms/dergeorg

# Tool versions. Renovate needs a customManager for this file (KEY=value after
# the marker) in the repository's renovate.json.
# renovate: datasource=maven depName=org.springframework.boot:spring-boot-dependencies
SPRING_BOOT_VERSION=4.1.2
# renovate: datasource=github-releases depName=JetBrains/kotlin
KOTLIN_VERSION=2.3.21
# renovate: datasource=maven depName=org.openapitools:openapi-generator-cli
OPENAPI_GENERATOR_VERSION=7.27.0
# renovate: datasource=npm depName=@redocly/cli
REDOCLY_VERSION=2.78.0
# renovate: datasource=github-releases depName=oasdiff/oasdiff
OASDIFF_VERSION=1.32.1
