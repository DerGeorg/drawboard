{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false,
    "schematicCollections": ["angular-eslint"]
  },
  "newProjectRoot": "projects",
  "projects": {
    "drawboard-frontend": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "none"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "drawboard",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "pdf.worker.min.mjs",
                "input": "node_modules/pdfjs-dist/build",
                "output": "pdfjs"
              },
              {
                "glob": "*",
                "input": "node_modules/pdfjs-dist/standard_fonts",
                "output": "pdfjs/standard_fonts"
              },
              {
                "glob": "*.bcmap",
                "input": "node_modules/pdfjs-dist/cmaps",
                "output": "pdfjs/cmaps"
              },
              {
                "glob": "*.icc",
                "input": "node_modules/pdfjs-dist/iccs",
                "output": "pdfjs/iccs"
              },
              {
                "glob": "{openjpeg.wasm,openjpeg_nowasm_fallback.js,jbig2.wasm,jbig2_nowasm_fallback.js,qcms_bg.wasm}",
                "input": "node_modules/pdfjs-dist/wasm",
                "output": "pdfjs/wasm"
              }
            ],
            "styles": ["src/styles.css"],
            "allowedCommonJsDependencies": [
              "ua-parser-js",
              "@opentelemetry/otlp-transformer",
              "@braintree/sanitize-url",
              "cytoscape-cose-bilkent",
              "cytoscape-fcose",
              "dayjs",
              "fastdom"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all",
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": true
              },
              "sourceMap": {
                "scripts": true,
                "styles": false,
                "hidden": true,
                "vendor": true
              }
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.development.ts"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "port": 4200,
            "proxyConfig": "proxy.conf.mjs"
          },
          "configurations": {
            "production": {
              "buildTarget": "drawboard-frontend:build:production"
            },
            "development": {
              "buildTarget": "drawboard-frontend:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "reporters": [
              "default",
              [
                "junit",
                {
                  "outputFile": "junit/unit-results.xml",
                  "suiteName": "unit"
                }
              ]
            ],
            "coverage": true,
            "coverageReporters": ["text-summary", "cobertura", "html"],
            "coverageExclude": [
              "src/app/test/**",
              "src/board-engine/testing/**",
              "src/environments/**",
              "src/main.ts"
            ],
            "coverageThresholds": {
              "statements": 80,
              "branches": 70,
              "functions": 80,
              "lines": 80
            }
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "src/**/*.ts",
              "src/**/*.html",
              "e2e/**/*.ts",
              "playwright.config.ts"
            ]
          }
        }
      }
    }
  }
}
