{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Drawboard chart values",
  "type": "object",
  "required": [
    "publicUrl",
    "oidc",
    "ingress",
    "postgresql"
  ],
  "properties": {
    "global": {
      "type": "object"
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "publicUrl": {
      "type": "string",
      "description": "Browser origin: scheme + host (+ port), no path, query or user info.",
      "pattern": "^https?://[^/?#@\\s]+/?$"
    },
    "environment": {
      "type": "string",
      "enum": [
        "local",
        "dev",
        "prod"
      ]
    },
    "timezone": {
      "type": "string"
    },
    "oidc": {
      "type": "object",
      "required": [
        "issuerUri",
        "audience"
      ],
      "properties": {
        "issuerUri": {
          "type": "string",
          "pattern": "^https?://\\S+$"
        },
        "audience": {
          "type": "string",
          "minLength": 1
        },
        "jwkSetUri": {
          "type": "string"
        },
        "claimUsername": {
          "type": "string",
          "minLength": 1
        },
        "claimGroups": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "adminGroup": {
      "type": "string"
    },
    "guests": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "backend": {
      "type": "object",
      "properties": {
        "image": {
          "$ref": "#/definitions/image"
        },
        "runAsUser": {
          "type": "integer",
          "minimum": 1
        },
        "runAsGroup": {
          "type": "integer",
          "minimum": 1
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "tmp": {
          "$ref": "#/definitions/sizeLimit"
        },
        "otlp": {
          "type": "object",
          "properties": {
            "endpoint": {
              "type": "string"
            }
          }
        },
        "collab": {
          "type": "object",
          "propertyNames": {
            "pattern": "^COLLAB_[A-Z0-9_]+$"
          }
        },
        "extraEnv": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "replicaCount": {
          "not": {},
          "description": "Not configurable: the backend is a single replica (architecture 3.1)."
        },
        "uploadSpool": {
          "$ref": "#/definitions/sizeLimit"
        },
        "files": {
          "type": "object",
          "propertyNames": {
            "pattern": "^FILES_[A-Z0-9_]+$"
          }
        }
      }
    },
    "frontend": {
      "type": "object",
      "properties": {
        "replicaCount": {
          "type": "integer",
          "minimum": 1
        },
        "image": {
          "$ref": "#/definitions/image"
        },
        "runAsUser": {
          "type": "integer",
          "minimum": 1
        },
        "runAsGroup": {
          "type": "integer",
          "minimum": 1
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "tmp": {
          "$ref": "#/definitions/sizeLimit"
        },
        "confd": {
          "$ref": "#/definitions/sizeLimit"
        },
        "oidc": {
          "type": "object",
          "properties": {
            "issuer": {
              "type": "string"
            },
            "clientId": {
              "type": "string",
              "minLength": 1
            },
            "scope": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "faro": {
          "type": "object",
          "properties": {
            "receiverUrl": {
              "type": "string"
            },
            "appName": {
              "type": "string"
            },
            "namespace": {
              "type": "string"
            },
            "samplingRate": {
              "type": "string",
              "pattern": "^(0|1|0?\\.[0-9]+)$"
            }
          }
        },
        "extraEnv": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "filesOrigin": {
          "type": "string",
          "pattern": "^(https?://[^/?#@\\s]+)?$"
        },
        "pluginOrigin": {
          "type": "string",
          "pattern": "^(https?://[^/?#@\\s]+)?$"
        }
      }
    },
    "postgresql": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "external": {
          "type": "object",
          "properties": {
            "host": {
              "type": "string"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "database": {
              "type": "string"
            },
            "user": {
              "type": "string"
            },
            "existingSecret": {
              "type": "string"
            },
            "passwordKey": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "auth": {
          "type": "object",
          "properties": {
            "database": {
              "type": "string",
              "minLength": 1
            },
            "username": {
              "type": "string",
              "minLength": 1
            },
            "existingSecret": {
              "type": "string"
            },
            "passwordKey": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "persistence": {
          "type": "object",
          "properties": {
            "size": {
              "type": "string"
            },
            "storageClassName": {
              "type": "string"
            },
            "accessModes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "retentionPolicy": {
              "type": "string",
              "enum": [
                "Retain",
                "Delete"
              ]
            }
          }
        }
      },
      "if": {
        "properties": {
          "enabled": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "auth"
        ],
        "properties": {
          "auth": {
            "required": [
              "existingSecret"
            ],
            "properties": {
              "existingSecret": {
                "minLength": 1
              }
            }
          }
        }
      },
      "else": {
        "required": [
          "external"
        ],
        "properties": {
          "external": {
            "required": [
              "host",
              "database",
              "user",
              "existingSecret"
            ],
            "properties": {
              "host": {
                "minLength": 1
              },
              "database": {
                "minLength": 1
              },
              "user": {
                "minLength": 1
              },
              "existingSecret": {
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "ingress": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "tls": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "nginx": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 60
            },
            "bodySize": {
              "type": "object",
              "properties": {
                "default": {
                  "type": "string",
                  "pattern": "^[0-9]+[kKmMgG]?$"
                },
                "files": {
                  "type": "string",
                  "pattern": "^[0-9]+[kKmMgG]?$"
                },
                "plugins": {
                  "type": "string",
                  "pattern": "^[0-9]+[kKmMgG]?$"
                },
                "snapshot": {
                  "type": "string",
                  "pattern": "^[0-9]+[kKmMgG]?$"
                }
              }
            },
            "requestBuffering": {
              "type": "boolean"
            }
          }
        },
        "annotations": {
          "type": "object"
        },
        "uploadAnnotations": {
          "type": "object"
        }
      },
      "if": {
        "properties": {
          "enabled": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "host"
        ],
        "properties": {
          "host": {
            "minLength": 1
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "trustedProxies": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-fA-F:.]+(/[0-9]{1,3})?$"
          }
        }
      ]
    },
    "secrets": {
      "type": "object",
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "create": {
          "type": "boolean"
        },
        "values": {
          "type": "object",
          "properties": {
            "fileUrlKeys": {
              "type": "string"
            },
            "pluginPseudonymKey": {
              "type": "string"
            },
            "guestSigningKeys": {
              "type": "string"
            }
          }
        },
        "keys": {
          "type": "object",
          "properties": {
            "fileUrlKeys": {
              "type": "string",
              "minLength": 1
            },
            "pluginPseudonymKey": {
              "type": "string",
              "minLength": 1
            },
            "guestSigningKeys": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "files": {
      "type": "object",
      "properties": {
        "origin": {
          "type": "string",
          "pattern": "^(https?://[^/?#@\\s]+)?$"
        },
        "persistence": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "existingClaim": {
              "type": "string"
            },
            "size": {
              "type": "string",
              "minLength": 1
            },
            "storageClassName": {
              "type": "string"
            },
            "accessModes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "annotations": {
              "type": "object"
            }
          }
        }
      }
    },
    "plugins": {
      "type": "object",
      "properties": {
        "origin": {
          "type": "string",
          "pattern": "^(https?://[^/?#@\\s]+)?$"
        }
      }
    },
    "clamav": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "maxBytes": {
          "type": [
            "integer",
            "string"
          ],
          "pattern": "^[0-9]*$"
        },
        "timeoutSeconds": {
          "type": [
            "integer",
            "string"
          ],
          "pattern": "^[0-9]*$"
        },
        "failClosed": {
          "type": "boolean"
        }
      }
    },
    "gotenberg": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "$ref": "#/definitions/image"
        },
        "runAsUser": {
          "type": "integer",
          "minimum": 1
        },
        "runAsGroup": {
          "type": "integer",
          "minimum": 1
        },
        "resources": {
          "type": "object"
        },
        "tmp": {
          "$ref": "#/definitions/sizeLimit"
        },
        "home": {
          "$ref": "#/definitions/sizeLimit"
        }
      }
    }
  },
  "definitions": {
    "image": {
      "type": "object",
      "required": [
        "repository"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "resources": {
      "type": "object",
      "required": [
        "requests",
        "limits"
      ]
    },
    "sizeLimit": {
      "type": "object",
      "required": [
        "sizeLimit"
      ],
      "properties": {
        "sizeLimit": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
