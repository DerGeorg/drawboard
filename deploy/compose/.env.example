# Drawboard - copy to .env and fill in. Never commit .env (it holds the database password).

# Where users open Drawboard (your reverse proxy terminates TLS and forwards to HTTP_PORT)
PUBLIC_URL=https://draw.example.org

# The frontend's port on this host. 127.0.0.1 = only a reverse proxy on this host reaches it;
# 0.0.0.0 when the proxy runs elsewhere (then also add its address to TRUSTED_PROXIES).
HTTP_BIND=127.0.0.1
HTTP_PORT=8080

# OpenID Connect provider (README, "Identity provider")
OIDC_ISSUER_URI=https://sso.example.org/realms/main
OIDC_CLIENT_ID=drawboard
OIDC_AUDIENCE=drawboard-api
OIDC_SCOPE=openid profile email groups
# Only when the backend must reach the provider under another address than the issuer:
# OIDC_JWK_SET_URI=http://keycloak:8080/realms/main/protocol/openid-connect/certs
# Members of this group (groups claim) are instance admins; empty = nobody
ADMIN_GROUP=

# PostgreSQL password, e.g. openssl rand -base64 32
DB_PASSWORD=

# The network of frontend and backend, and every proxy in front of the frontend (comma separated).
# Wrong values make all users look like one address (rate limits) - README, "Trusted proxies".
WEB_SUBNET=172.30.37.0/24
TRUSTED_PROXIES=172.30.37.0/24

# Guest links: only after README, "Before enabling guest links"
GUESTS_ENABLED=false

# Third-party plugins: their own hostname, e.g. https://draw-plugins.example.org (README)
PLUGIN_ORIGIN=

TZ=UTC
DRAWBOARD_BACKEND_VERSION=1.16.0
DRAWBOARD_FRONTEND_VERSION=1.22.0
