{
  "realm": "drawboard",
  "displayName": "drawboard (local dev)",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "accessTokenLifespan": 300,
  "clientScopes": [
    {
      "name": "groups",
      "description": "Group names (without path) in the claim 'groups', like Authelia does",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "groups": [
    {
      "name": "drawboard-users"
    },
    {
      "name": "drawboard-admins"
    }
  ],
  "clients": [
    {
      "clientId": "drawboard-api",
      "name": "drawboard API (bearer-only resource server, audience of the tokens)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false
    },
    {
      "clientId": "drawboard-web",
      "name": "drawboard SPA + Swagger UI (public client, PKCE)",
      "description": "Local: frontend dev server http://localhost:4200 (ng serve), frontend image http://localhost:18090, Swagger UI of the backend http://localhost:18081",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "defaultClientScopes": [
        "basic",
        "profile",
        "email",
        "groups"
      ],
      "redirectUris": [
        "http://localhost:4200/*",
        "http://localhost:18090/*",
        "http://localhost:18081/swagger-ui/oauth2-redirect.html"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:4200/*##http://localhost:18090/*"
      },
      "protocolMappers": [
        {
          "name": "audience-drawboard-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "drawboard-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "drawboard-dev",
      "name": "LOCAL DEV ONLY: curl/Postman tokens via password grant (never in a shared realm)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "drawboard-dev-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "defaultClientScopes": [
        "basic",
        "profile",
        "email",
        "groups"
      ],
      "protocolMappers": [
        {
          "name": "audience-drawboard-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "drawboard-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "emailVerified": true,
      "email": "alice@example.test",
      "firstName": "Alice",
      "lastName": "Admin",
      "credentials": [
        {
          "type": "password",
          "value": "alice-dev",
          "temporary": false
        }
      ],
      "groups": [
        "/drawboard-admins"
      ]
    },
    {
      "username": "bob",
      "enabled": true,
      "emailVerified": true,
      "email": "bob@example.test",
      "firstName": "Bob",
      "lastName": "Builder",
      "credentials": [
        {
          "type": "password",
          "value": "bob-dev",
          "temporary": false
        }
      ],
      "groups": [
        "/drawboard-users"
      ]
    }
  ]
}
