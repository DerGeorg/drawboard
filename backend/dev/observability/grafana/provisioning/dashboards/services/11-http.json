        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "regex": "",
        "options": [],
        "query": {
          "qryType": 1,
          "query": "label_values(target_info, deployment_environment_name)",
          "refId": "env"
        }
      },
