{
  "uid": "svc-spans",
  "title": "12 · Spans & Service-Map",
  "tags": [
    "services",
    "traces"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "editable": false,
  "graphTooltip": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "Umgebung",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(target_info, deployment_environment_name)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "regex": "",
        "options": [],
        "query": {
          "qryType": 1,
          "query": "label_values(target_info, deployment_environment_name)",
          "refId": "env"
        }
      },
      {
        "name": "service",
        "label": "Dienst",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(target_info{deployment_environment_name=~\"$env\"}, service_name)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "regex": "",
        "options": [],
        "query": {
          "qryType": 1,
          "query": "label_values(target_info{deployment_environment_name=~\"$env\"}, service_name)",
          "refId": "service"
        }
      },
      {
        "name": "span",
        "label": "Span",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(traces_spanmetrics_calls_total{service=~\"$service\",deployment_environment_name=~\"$env\"}, span_name)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "regex": "",
        "options": [],
        "query": {
          "qryType": 1,
          "query": "label_values(traces_spanmetrics_calls_total{service=~\"$service\",deployment_environment_name=~\"$env\"}, span_name)",
          "refId": "span"
        }
      }
    ]
  },
