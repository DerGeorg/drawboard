      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(rate(http_server_requests_seconds_count{service_name=~\"$service\",deployment_environment_name=~\"$env\",status=~\"5..\"}[5m])) or 0 * sum(rate(http_server_requests_seconds_count{service_name=~\"$service\",deployment_environment_name=~\"$env\"}[5m]))) / sum(rate(http_server_requests_seconds_count{service_name=~\"$service\",deployment_environment_name=~\"$env\"}[5m]))",
          "legendFormat": "5xx",
          "refId": "A",
          "editorMode": "code",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          },
          "unit": "percentunit",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
