      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(http_server_requests_seconds_count{service_name=~\"$service\",deployment_environment_name=~\"$env\"}[5m]))",
          "legendFormat": "Req/s",
          "refId": "A",
          "editorMode": "code",
          "range": false,
          "instant": true
