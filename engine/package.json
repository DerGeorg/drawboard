{
  "name": "@apps/drawboard-engine",
  "version": "0.0.0",
  "description": "The DOM-free core of the Drawboard board engine: board model, file format, templates, collaboration protocol.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://gitlab.dergeorg.at/apps/drawboard/engine.git"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.build.json && node scripts/check-dist.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:ci": "npm run typecheck && vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "packageManager": "npm@11.21.2",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "lib0": "^0.2.120"
  },
  "peerDependencies": {
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@ci/eslint-plugin": "^1.4.5",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "angular-eslint": "^22.6.0",
    "emojibase-data": "^18.0.0",
    "eslint": "^10.14.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33"
  }
}
