# Our own npm packages are scoped by the root namespace of their GitLab project
# (@apps/<app>-api from apps/<app>/api, @ci/eslint-plugin from ci/eslint-rules)
# and served through the instance-level endpoint of the GitLab package registry.
# The token comes from the environment, never from this file:
#   local: export NPM_TOKEN=<personal access token, scope read_api>
#   CI:    NPM_TOKEN=$CI_JOB_TOKEN (the source projects allow this project in their job-token allowlist)
@apps:registry=https://gitlab.dergeorg.at/api/v4/packages/npm/
@ci:registry=https://gitlab.dergeorg.at/api/v4/packages/npm/
//gitlab.dergeorg.at/api/v4/packages/npm/:_authToken=${NPM_TOKEN}
